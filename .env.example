# Copy this file to .env and fill in local values.
# PostgreSQL runs on port 5433 in the local development example.

DB_NAME=cosmetics_price_monitoring
DB_USER=cosmetics
DB_PASSWORD=change-me
DB_PORT=5433
DB_HOST=localhost

API_PORT=3001
AUTH_SERVICE_PORT=3002
NODE_ENV=development

ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

FE_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
AUTH_ORIGIN=http://localhost:3002
API_INTERNAL_URL=http://localhost:3001
INTERNAL_API_KEY=change-me

# Separate database and role for the auth service.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_NAME=cosmetics_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me

# Required by the API at startup. Use a real token only if you run the bot.
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_LINK=https://t.me/example_bot
API_KEY=change-me

# Optional worker settings
# PARSER_STORE=eva
# PARSER_CONCURRENCY=2
# PARSER_DELAY_MS=2000
# PARSER_POLL_MS=1000
# NOTIFIER_POLL_MS=1000
# SCHEDULER_TIMEZONE=Europe/Kyiv
