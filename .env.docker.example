# Copy this file to .env.docker and fill in local values

DB_NAME=cosmetics_price_monitoring
DB_USER=cosmetics
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

AUTH_DB_NAME=cosmetics_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432

API_PORT=3001
AUTH_SERVICE_PORT=3002

NODE_ENV=development

ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

FE_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
AUTH_ORIGIN=http://localhost:3002

API_INTERNAL_URL=http://api:3001
INTERNAL_API_KEY=change-me

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_LINK=https://t.me/example_bot
API_KEY=change-me

