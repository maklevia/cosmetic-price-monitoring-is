# Copy this file to .env.docker and fill in local values

DB_NAME=cosmetics_price_monitoring
DB_USER=cosmetics
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

AUTH_DB_NAME=cosmetics_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432

# Internal container ports. They are not published on the host.
API_PORT=3001
AUTH_SERVICE_PORT=3002

# Host port for the nginx web container, bound to 127.0.0.1.
WEB_PORT=8080

NODE_ENV=development

ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Browser origin served by the web container.
FE_ORIGIN=http://localhost:8080

# Build-time frontend URLs. nginx strips these prefixes before proxying.
API_ORIGIN=/api
AUTH_ORIGIN=/auth

# Service-to-service URL used by auth-service and the Telegram bot.
API_INTERNAL_URL=http://api:3001
INTERNAL_API_KEY=change-me

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_LINK=https://t.me/example_bot
API_KEY=change-me

# Optional worker settings.
# PARSER_STORE=eva
# PARSER_CONCURRENCY=2
# PARSER_DELAY_MS=2000
# PARSER_POLL_MS=1000
# NOTIFIER_POLL_MS=1000
# SCHEDULER_TIMEZONE=Europe/Kyiv
